# ---------- Public (safe for the browser) ----------
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# WhatsApp support number in international format, digits only (e.g. 923001234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=support@your-domain.example

# ---------- Server only (NEVER prefix with NEXT_PUBLIC_) ----------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Random 32+ char secret used to HMAC identifiers before logging (never log raw numbers)
LOG_HASH_SECRET=change-me-to-a-long-random-string

# ---------- Optional: legally authorized verification provider ----------
# Leave blank unless you hold a written agreement / approval that permits this lookup.
# While blank, the tool shows the official verification steps only.
VERIFICATION_API_URL=
VERIFICATION_API_KEY=
# Comma-separated response fields the provider is legally permitted to return and you may display
VERIFICATION_ALLOWED_FIELDS=network,status
